# Genel
NODE_ENV=development
PORT=5000

# Veritabanı
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_pass
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://ecom:ecom_pass@localhost:5432/ecommerce

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@domain.com
SMTP_PASS=smtp-password
SMTP_FROM=noreply@domain.com

# Cloudinary (görsel yükleme)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# İyzico (ödeme)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Admin varsayılan kullanıcı (seed için)
ADMIN_EMAIL=admin@domain.com
ADMIN_PASSWORD=Admin123!
