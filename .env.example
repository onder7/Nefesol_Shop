# ─────────────────────────────────────────────────────────────────
#  .env.example — Bu dosyayı .env olarak kopyalayın ve doldurun
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# Genel
NODE_ENV=production
PORT=5000

# ─── Veritabanı ───────────────────────────────────────────────────
POSTGRES_USER=ecom
POSTGRES_PASSWORD=GUCLU_SIFRE_DEGISTIR
POSTGRES_DB=ecommerce
# Docker Compose'da container adı 'postgres'
DATABASE_URL=postgresql://ecom:GUCLU_SIFRE_DEGISTIR@postgres:5432/ecommerce

# ─── Redis ────────────────────────────────────────────────────────
# Docker Compose'da container adı 'redis'
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────
# En az 32 karakter, rastgele üretin: openssl rand -hex 32
JWT_SECRET=BURAYA_GUCLU_RASTGELE_SECRET_YAZIN
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=BURAYA_BASKA_GUCLU_RASTGELE_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────
# Admin de aynı domain'de olduğu için her ikisi de aynı değer
FRONTEND_URL=https://example.com
ADMIN_URL=https://example.com

# ─── Email (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=uygulama_sifresi
SMTP_FROM=noreply@example.com

# ─── Cloudinary (opsiyonel, yerel depolama yerine) ────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── İyzico (ödeme) ───────────────────────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ─── Admin varsayılan kullanıcı (ilk seed için) ───────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
